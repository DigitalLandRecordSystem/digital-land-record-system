# Database
DATABASE_PATH=../database/land_records.db
SCHEMA_PATH=../database/schema.sql
MASTER_KEY_PATH=../database/master_key.json

# Crypto settings
KDF_ITERATIONS=1000
RSA_KEY_BITS=1024
SESSION_LIFETIME_MINUTES=30

# Secrets - generated, never committed
BLIND_INDEX_KEY=<64 hex chars from the command in README.md>
FLASK_SECRET_KEY=<64 hex chars from the command in README.md>
INTEGRITY_KEY=<64 hex chars from the command in README.md>